{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && ((!data.exists() && newData.child('id').val() === $roomId && newData.child('hostUid').val() === auth.uid && newData.child('status').val() === 'waiting') || (data.exists() && data.child('hostUid').val() === auth.uid && newData.child('id').val() === $roomId && newData.child('hostUid').val() === auth.uid) || (!newData.exists() && !root.child('roomPlayers').child($roomId).exists()))",
        ".validate": "newData.hasChildren(['id', 'name', 'hostUid', 'status', 'settings', 'createdAt', 'updatedAt'])",
        "id": {
          ".validate": "newData.isString() && newData.val() === $roomId"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 30"
        },
        "hostUid": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && (data.val() === auth.uid || root.child('roomPlayers').child($roomId).child(auth.uid).exists()) && root.child('roomPlayers').child($roomId).child(newData.val()).exists()))",
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && (newData.val() === data.val() || root.child('roomPlayers').child($roomId).child(newData.val()).exists())))"
        },
        "status": {
          ".write": "auth != null && root.child('roomPlayers').child($roomId).child(auth.uid).exists()",
          ".validate": "newData.val() === 'waiting' || newData.val() === 'playing'"
        },
        "settings": {
          ".validate": "newData.hasChildren(['bigBlind'])",
          "bigBlind": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "gameState": {
          ".validate": "newData.hasChildren(['currentBigBlindUid', 'handNumber'])",
          "currentBigBlindUid": {
            ".write": "auth != null && root.child('roomPlayers').child($roomId).child(auth.uid).exists()",
            ".validate": "newData.isString() && root.child('roomPlayers').child($roomId).child(newData.val()).exists()"
          },
          "handNumber": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          },
          "hand": {
            ".write": "auth != null && root.child('roomPlayers').child($roomId).child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['dealerPosition', 'smallBlindPosition', 'bigBlindPosition', 'currentTurn', 'bettingRound', 'pot', 'currentBet', 'minimumRaise', 'smallBlind', 'bigBlind', 'players'])",
            "dealerPosition": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "smallBlindPosition": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "bigBlindPosition": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "currentTurn": {
              ".validate": "newData.isNumber() && newData.val() >= -1"
            },
            "bettingRound": {
              ".validate": "newData.val() === 'preflop' || newData.val() === 'flop' || newData.val() === 'turn' || newData.val() === 'river' || newData.val() === 'showdown'"
            },
            "pot": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "currentBet": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "minimumRaise": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "smallBlind": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "bigBlind": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "players": {
              ".validate": "newData.exists()"
            },
            "communityCards": {
              ".validate": "newData.exists()"
            },
            "playerCards": {
              ".validate": "newData.exists()"
            },
            "actionLog": {
              ".validate": "newData.exists()"
            },
            "lastAggressorPosition": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "$other": {
              ".validate": false
            }
          },
          "settlements": {
            ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() === auth.uid",
            ".validate": "newData.exists()"
          },
          "$other": {
            ".validate": false
          }
        },
        "createdAt": {
          ".validate": "newData.exists()"
        },
        "updatedAt": {
          ".write": "auth != null && root.child('roomPlayers').child($roomId).child(auth.uid).exists()",
          ".validate": "newData.exists()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roomPlayers": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && $uid === auth.uid && (!newData.exists() || newData.child('uid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['uid', 'role', 'joinedAt', 'online'])",
          "uid": {
            ".validate": "newData.isString() && newData.val() === $uid"
          },
          "displayName": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20"
          },
          "role": {
            ".validate": "(!data.exists() && (newData.val() === 'host' || newData.val() === 'player')) || (data.exists() && newData.val() === data.val())"
          },
          "joinedAt": {
            ".validate": "newData.exists()"
          },
          "seatIndex": {
            ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() === auth.uid",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
          },
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "roomSecrets": {
      "$roomId": {
        ".read": "auth != null && data.child('hostUid').val() === auth.uid",
        ".write": "auth != null && ((newData.child('hostUid').val() === auth.uid && (!data.exists() || data.child('hostUid').val() === auth.uid)) || (!newData.exists() && !root.child('roomPlayers').child($roomId).exists()))",
        ".validate": "newData.hasChildren(['hostUid', 'passcodeHash'])",
        "hostUid": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && root.child('roomPlayers').child($roomId).child(auth.uid).exists() && root.child('roomPlayers').child($roomId).child(newData.val()).exists()))",
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && root.child('roomPlayers').child($roomId).child(newData.val()).exists()))"
        },
        "passcodeHash": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val().length === 64"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false,
      ".validate": false
    }
  }
}
