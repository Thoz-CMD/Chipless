{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null"
      }
    },
    "roomPlayers": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null"
        }
      }
    },
    "roomPlayerHistory": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null"
        }
      }
    },
    "roomSecrets": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "gameHistory": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId"
      }
    },
    "roomEmojis": {
      "$roomId": {
        ".read": "auth != null",
        ".indexOn": ["timestamp"],
        "$emojiId": {
          ".write": "auth != null"
        }
      }
    },
    "roomTipNotifications": {
      "$roomId": {
        ".read": "auth != null",
        ".indexOn": ["timestamp"],
        "$notificationId": {
          ".write": "auth != null"
        }
      }
    },
    "dealerHands": {
      "$roomId": {
        "$handNumber": {
          "deckToken": {
            ".read": false,
            ".write": false
          },
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": false
          }
        }
      }
    }
  }
}
